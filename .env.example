# Database
DB_NAME=parecare
DB_USER=parecare
DB_PASSWORD=changeme

# App
NODE_ENV=production
PORT=80
JWT_SECRET=generate-a-long-random-string-min-32-chars
API_URL=http://localhost:3001

# Self-host mode (set to false for SaaS deployment)
SELF_HOSTED=true

# User roles: the account with this email becomes the super admin.
# Set it BEFORE that account registers (or restart the api after migrating
# an existing install) — it is promoted automatically.
SUPER_ADMIN_EMAIL=

# AI assistant. By default Pare runs on this machine through the bundled
# ollama service: nothing leaves here, no key is needed, and the model that
# suits this machine is downloaded on first start. Leave this section as it is
# to keep Pare local.
#
#   ollama (default)     -> runs on this machine; no key. The model is chosen
#                           and downloaded for you (see AI_MODEL_GPU/CPU below).
#   anthropic            -> use Claude instead: set ANTHROPIC_API_KEY (or
#                           AI_API_KEY). Faster, but records are sent to
#                           Anthropic to be read.
#   openai               -> set AI_API_KEY
#   google               -> set AI_API_KEY (Google AI Studio key)
#   lmstudio             -> set AI_MODEL to the model you run locally;
#                           AI_BASE_URL defaults to the usual local port
#   openai-compatible    -> set AI_BASE_URL (ending in /v1) + AI_MODEL
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
AI_API_KEY=
# Leave both blank to use the bundled ollama service. The app then talks to
# the on-machine model under the stable name "parecare".
AI_BASE_URL=
AI_MODEL=
# The best model available for the heavy, rare jobs (reading a whole document,
# writing a care plan). Leave blank to reuse the model above; set a cloud model
# here to send only those jobs away while everything else stays local.
AI_MEDIATION_MODEL=
# Which local model is downloaded on first start. A graphics card gets the
# larger one; anything else gets the smaller one. Both read text and images.
# Change only to pin a different model.
AI_MODEL_GPU=gemma4:12b-it-q4_K_M
AI_MODEL_CPU=gemma4:e4b-it-q4_K_M

# Social sign-in (optional — buttons appear when configured).
# Redirect URI to register with the provider: <APP_URL>/api/v1/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Storage (local = uploads folder, s3 = AWS S3 compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@parecare.app

# Subscriptions (SaaS only — leave empty for self-hosted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY=
STRIPE_PRICE_PROFESSIONAL=

# App URL (used for Stripe redirect URLs)
APP_URL=http://localhost

# Plan limits (tokens per billing cycle, -1 = unlimited)
AI_TOKENS_FREE=0
AI_TOKENS_FAMILY=100000
AI_TOKENS_PROFESSIONAL=-1
